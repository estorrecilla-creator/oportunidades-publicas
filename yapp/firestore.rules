rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfiles: cualquier usuario autenticado puede leerlos (para explorar),
    // pero solo el dueño puede crear/editar el suyo.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Chats (1 a 1 y grupos): solo los participantes pueden leer/escribir.
    // Para grupos, solo el creador puede cambiar la lista de participantes
    // (añadir/quitar miembros) — el resto de campos los puede tocar cualquiera.
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          request.resource.data.participants == resource.data.participants
          || request.auth.uid == resource.data.createdBy
        );

      // Mensajes: solo los participantes del chat pueden leerlos,
      // y solo se puede crear un mensaje como uno mismo.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // Salas públicas de nicho (y la sala "general"): cualquier usuario
    // autenticado puede verlas, crearlas y escribir mensajes en ellas.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false;
      }
    }
  }
}
