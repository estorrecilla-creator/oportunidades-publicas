rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfiles: cualquier usuario autenticado puede leerlos (para explorar),
    // pero solo el dueño puede crear/editar el suyo.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Chats: solo los dos participantes pueden leer/escribir la conversación.
    match /chats/{chatId} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      // Mensajes: solo los participantes del chat pueden leerlos,
      // y solo se puede crear un mensaje como uno mismo.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
